PORT=5000

# memory = data lost on restart | supabase = persisted in Supabase
USER_STORE=supabase

# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the service_role key (secret). Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Only used when USER_STORE=memory
ADMIN_EMAIL=admin@cleaniq.com
ADMIN_PASSWORD=Admin1234

# JWT secret for login tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
